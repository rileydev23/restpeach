<Project Sdk="Microsoft.NET.Sdk">
  <!-- restpeach-cli: runs the same .api folder headless, for CI pipelines (exit code 0 = everything passed). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>restpeach-cli</AssemblyName>
    <RootNamespace>RestPeach.Cli</RootNamespace>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RestPeach.Core\RestPeach.Core.csproj" />
  </ItemGroup>
</Project>
