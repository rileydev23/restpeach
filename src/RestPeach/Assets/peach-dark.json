{
  "name": "Peach Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1b1c1f",
    "editor.foreground": "#d4d4d4",
    "editor.selectionBackground": "#33507a",
    "editor.lineHighlightBackground": "#232428",
    "editorLineNumber.foreground": "#5d6066",
    "editorLineNumber.activeForeground": "#c8c8c8",
    "editorCursor.foreground": "#4a90d9"
  },
  "tokenColors": [
    { "settings": { "foreground": "#d4d4d4", "background": "#1b1c1f" } },
    { "scope": ["comment", "punctuation.definition.comment", "string.comment"], "settings": { "foreground": "#6f737a", "fontStyle": "italic" } },
    { "scope": ["comment.block.documentation", "comment.line.double-slash.documentation"], "settings": { "foreground": "#7c8a7f", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.other.using", "keyword.other.namespace"], "settings": { "foreground": "#d96a9b" } },
    { "scope": ["keyword.operator", "punctuation.separator.key-value"], "settings": { "foreground": "#a9acb2" } },
    { "scope": ["punctuation", "meta.brace", "punctuation.definition.tag"], "settings": { "foreground": "#8a8d93" } },
    { "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#8fcf94" } },
    { "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"], "settings": { "foreground": "#e0645a" } },
    { "scope": ["constant.numeric", "constant.language", "constant.language.boolean", "constant.language.null", "support.constant", "constant.other.color"], "settings": { "foreground": "#e0a24a" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "entity.name.interface", "entity.other.inherited-class", "support.class", "support.type", "storage.type.cs", "storage.type.primitive", "entity.name.type.namespace", "entity.name.namespace"], "settings": { "foreground": "#4ac7c0" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "entity.name.method", "variable.function"], "settings": { "foreground": "#7db4ea" } },
    { "scope": ["variable", "variable.other", "variable.parameter", "meta.definition.variable"], "settings": { "foreground": "#d4d4d4" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "entity.name.variable.property", "variable.other.member", "meta.object-literal.key", "entity.name.tag.yaml", "support.type.property-name"], "settings": { "foreground": "#a8c8e8" } },
    { "scope": ["variable.language", "variable.language.this", "keyword.other.this", "keyword.other.base"], "settings": { "foreground": "#d96a9b", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag", "meta.tag.sgml", "markup.deleted.git_gutter"], "settings": { "foreground": "#4a90d9" } },
    { "scope": ["entity.other.attribute-name", "entity.other.attribute-name.id", "entity.other.attribute-name.class"], "settings": { "foreground": "#9a7ae0" } },
    { "scope": ["meta.attribute", "meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation", "meta.annotation"], "settings": { "foreground": "#c8c84a" } },
    { "scope": ["entity.name.label", "entity.name.section"], "settings": { "foreground": "#e0a24a" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive", "punctuation.definition.directive", "keyword.preprocessor"], "settings": { "foreground": "#9a7ae0" } },
    { "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown"], "settings": { "foreground": "#4a90d9", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#7db4ea" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#e0a24a" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#8a8d93", "fontStyle": "italic" } },
    { "scope": ["markup.list", "punctuation.definition.list"], "settings": { "foreground": "#d96a9b" } },
    { "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "#a6e3b4" } },
    { "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "#f4a6a6" } },
    { "scope": ["markup.changed", "meta.diff.range"], "settings": { "foreground": "#e0a24a" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#e0645a" } }
  ]
}
