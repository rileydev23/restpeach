<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:RestPeach.Services"
             xmlns:vm="using:RestPeach.ViewModels"
             x:Class="RestPeach.Views.AuthView"
             x:DataType="vm:AuthEditor">
  <StackPanel Spacing="8" MaxWidth="640" HorizontalAlignment="Left">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="{l:L auth.type}" Classes="dim" VerticalAlignment="Center" Width="90" />
      <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" MinWidth="200" />
    </StackPanel>
    <TextBlock Text="{Binding InheritedText}" Classes="dim" FontSize="12" IsVisible="{Binding IsInherit}" Margin="100,0,0,0" TextWrapping="Wrap" />
    <TextBlock Text="{l:L auth.none.hint}" Classes="dim" FontSize="12" IsVisible="{Binding IsNone}" Margin="100,0,0,0" TextWrapping="Wrap" />

    <Grid ColumnDefinitions="100,*" IsVisible="{Binding IsBearer}">
      <TextBlock Text="Token" Classes="dim" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Classes="mono" Text="{Binding Token}" Watermark="{}{{TOKEN}}" />
    </Grid>

    <!-- OAuth 2.0: where the token comes from (the user / password rows below are the password grant's). -->
    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,6,Auto,6,Auto,6,Auto,6,Auto,6,Auto,6,Auto" IsVisible="{Binding IsOAuth2}">
      <TextBlock Text="{l:L oauth.grant}" Classes="dim" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Grants}" SelectedItem="{Binding Grant}" MinWidth="240" />
      <TextBlock Grid.Row="2" Text="{l:L oauth.authUrl}" Classes="dim" VerticalAlignment="Center" IsVisible="{Binding IsCodeGrant}" />
      <TextBox Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding AuthUrl}" Watermark="https://login.example.com/oauth/authorize" IsVisible="{Binding IsCodeGrant}" />
      <TextBlock Grid.Row="4" Text="{l:L oauth.tokenUrl}" Classes="dim" VerticalAlignment="Center" />
      <TextBox Grid.Row="4" Grid.Column="1" Classes="mono" Text="{Binding TokenUrl}" Watermark="https://login.example.com/oauth/token" />
      <TextBlock Grid.Row="6" Text="Client ID" Classes="dim" VerticalAlignment="Center" />
      <TextBox Grid.Row="6" Grid.Column="1" Classes="mono" Text="{Binding ClientId}" Watermark="{}{{CLIENT_ID}}" />
      <TextBlock Grid.Row="8" Text="Client secret" Classes="dim" VerticalAlignment="Center" />
      <TextBox Grid.Row="8" Grid.Column="1" Classes="mono" Text="{Binding ClientSecret}" Watermark="{l:L oauth.secret.watermark}" />
      <TextBlock Grid.Row="10" Text="Scope" Classes="dim" VerticalAlignment="Center" />
      <TextBox Grid.Row="10" Grid.Column="1" Classes="mono" Text="{Binding Scope}" Watermark="read:users write:orders" />
      <TextBlock Grid.Row="12" Text="{l:L oauth.redirect}" Classes="dim" VerticalAlignment="Center" IsVisible="{Binding IsCodeGrant}" />
      <TextBox Grid.Row="12" Grid.Column="1" Classes="mono" Text="{Binding RedirectUri}" Watermark="{l:L oauth.redirect.watermark}" IsVisible="{Binding IsCodeGrant}" />
    </Grid>

    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,6,Auto" IsVisible="{Binding HasUserPassword}">
      <TextBlock Text="{l:L auth.username}" Classes="dim" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Classes="mono" Text="{Binding Username}" />
      <TextBlock Grid.Row="2" Text="{l:L auth.password}" Classes="dim" VerticalAlignment="Center" />
      <TextBox Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding Password}" Watermark="{}{{PASSWORD}}" />
    </Grid>

    <StackPanel Spacing="8" IsVisible="{Binding IsOAuth2}">
      <Grid ColumnDefinitions="100,*">
        <TextBlock Text="{l:L oauth.clientAuth}" Classes="dim" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding ClientAuths}" SelectedItem="{Binding ClientAuth}" MinWidth="240" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="100,4,0,0">
        <Button Content="{l:L oauth.getToken}" Command="{Binding GetTokenCommand}" IsEnabled="{Binding !IsFetchingToken}" ToolTip.Tip="{l:L oauth.getToken.tip}" />
        <Button Classes="flat" Content="{l:L oauth.forget}" Command="{Binding ForgetTokenCommand}" Foreground="#8a8d93" ToolTip.Tip="{l:L oauth.forget.tip}" />
      </StackPanel>
      <TextBlock Text="{Binding TokenStatus}" Classes="dim" FontSize="12" Margin="100,0,0,0" TextWrapping="Wrap" />
      <TextBlock Text="{l:L oauth.hint}" Classes="dim" FontSize="11" Margin="100,0,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <TextBlock Text="{l:L digest.hint}" Classes="dim" FontSize="11" Margin="100,0,0,0" TextWrapping="Wrap" IsVisible="{Binding IsDigest}" />

    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,6,Auto,6,Auto,6,Auto,6,Auto,6,Auto" IsVisible="{Binding IsAws}">
      <TextBlock Text="Access key" Classes="dim" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Classes="mono" Text="{Binding AccessKey}" Watermark="{}{{AWS_ACCESS_KEY_ID}}" />
      <TextBlock Grid.Row="2" Text="Secret key" Classes="dim" VerticalAlignment="Center" />
      <TextBox Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding SecretKey}" Watermark="{}{{AWS_SECRET_ACCESS_KEY}}" />
      <TextBlock Grid.Row="4" Text="{l:L aws.region}" Classes="dim" VerticalAlignment="Center" />
      <TextBox Grid.Row="4" Grid.Column="1" Classes="mono" Text="{Binding Region}" Watermark="us-east-1" />
      <TextBlock Grid.Row="6" Text="{l:L aws.service}" Classes="dim" VerticalAlignment="Center" />
      <TextBox Grid.Row="6" Grid.Column="1" Classes="mono" Text="{Binding Service}" Watermark="execute-api · s3 · lambda" />
      <TextBlock Grid.Row="8" Text="Session token" Classes="dim" VerticalAlignment="Center" />
      <TextBox Grid.Row="8" Grid.Column="1" Classes="mono" Text="{Binding SessionToken}" Watermark="{l:L aws.session.watermark}" />
      <TextBlock Grid.Row="10" Grid.Column="1" Text="{l:L aws.hint}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
    </Grid>

    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,6,Auto,6,Auto" IsVisible="{Binding IsApiKey}">
      <TextBlock Text="{l:L auth.key}" Classes="dim" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Classes="mono" Text="{Binding Key}" Watermark="X-Api-Key" />
      <TextBlock Grid.Row="2" Text="{l:L auth.value}" Classes="dim" VerticalAlignment="Center" />
      <TextBox Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding Value}" Watermark="{}{{API_KEY}}" />
      <TextBlock Grid.Row="4" Text="{l:L auth.addTo}" Classes="dim" VerticalAlignment="Center" />
      <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Locations}" SelectedItem="{Binding Location}" MinWidth="200" />
    </Grid>

    <TextBlock Text="{l:L auth.secretsHint}" Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
               IsVisible="{Binding !IsInherit}" />
  </StackPanel>
</UserControl>
